diff --git a/lmms_eval/utils.py b/lmms_eval/utils.py
index 73b1728..5419c2f 100755
--- a/lmms_eval/utils.py
+++ b/lmms_eval/utils.py
@@ -790,6 +790,174 @@ def _git_output(*args: str) -> str:
     )
 
 
+def _git_output_from(repo_root: pathlib.Path, *args: str) -> str | None:
+    try:
+        return (
+            subprocess.check_output(
+                ["git", "-C", str(repo_root), *args],
+                stderr=subprocess.DEVNULL,
+            )
+            .strip()
+            .decode()
+        )
+    except (subprocess.CalledProcessError, FileNotFoundError, UnicodeDecodeError):
+        return None
+
+
+def _git_bytes_from(repo_root: pathlib.Path, *args: str) -> bytes:
+    try:
+        return subprocess.check_output(
+            ["git", "-C", str(repo_root), *args],
+            stderr=subprocess.DEVNULL,
+        )
+    except (subprocess.CalledProcessError, FileNotFoundError):
+        return b""
+
+
+def _sha256_bytes(payload: bytes) -> str:
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _sha256_file(path: pathlib.Path) -> str | None:
+    try:
+        return _sha256_bytes(path.read_bytes())
+    except OSError:
+        return None
+
+
+def _repo_state(repo_root: pathlib.Path) -> dict[str, Any]:
+    status = _git_output_from(repo_root, "status", "--short", "--untracked-files=normal")
+    status_lines = status.splitlines() if status else []
+    tracked_status = _git_output_from(repo_root, "status", "--short", "--untracked-files=no")
+    tracked_status_lines = tracked_status.splitlines() if tracked_status else []
+    untracked_status_lines = [line for line in status_lines if line.startswith("?? ")]
+    diff = _git_bytes_from(repo_root, "diff", "--binary", "--no-ext-diff")
+    return {
+        "path": str(repo_root),
+        "branch": _git_output_from(repo_root, "branch", "--show-current"),
+        "commit": _git_output_from(repo_root, "rev-parse", "HEAD"),
+        "dirty": bool(status_lines),
+        "tracked_dirty": bool(tracked_status_lines),
+        "status_sha256": hash_string("\n".join(status_lines)) if status_lines else None,
+        "status": status_lines[:200],
+        "status_truncated": len(status_lines) > 200,
+        "tracked_status": tracked_status_lines[:200],
+        "tracked_status_truncated": len(tracked_status_lines) > 200,
+        "untracked_status": untracked_status_lines[:200],
+        "untracked_status_truncated": len(untracked_status_lines) > 200,
+        "tracked_diff_sha256": _sha256_bytes(diff) if diff else None,
+    }
+
+
+def _package_version(package_name: str) -> str | None:
+    try:
+        import importlib.metadata
+
+        return importlib.metadata.version(package_name)
+    except Exception:
+        return None
+
+
+def get_reproducibility_info() -> dict[str, Any]:
+    workspace_root = pathlib.Path(os.getcwd()).resolve()
+    resolved_workspace = _git_output_from(workspace_root, "rev-parse", "--show-toplevel")
+    if resolved_workspace:
+        workspace_root = pathlib.Path(resolved_workspace).resolve()
+
+    lmms_root = _lmms_eval_repo_root().resolve()
+    file_hashes = {}
+    for relative_path in (
+        "pixi.toml",
+        "pixi.lock",
+        "Taskfile.yml",
+        "scripts/setup_pixi.sh",
+        "scripts/verify_environment.py",
+        "scripts/check_video_decode.py",
+        "patches/lmms-eval-qwen-video-repro.patch",
+        "third-party/lmms-eval/lmms_eval/models/simple/qwen2_5_vl.py",
+        "third-party/lmms-eval/lmms_eval/models/chat/qwen2_5_vl.py",
+        "third-party/lmms-eval/lmms_eval/loggers/wandb_logger.py",
+    ):
+        file_hash = _sha256_file(workspace_root / relative_path)
+        if file_hash:
+            file_hashes[relative_path] = file_hash
+
+    env_keys = (
+        "CUDA_VISIBLE_DEVICES",
+        "HF_HOME",
+        "PYTHONNOUSERSITE",
+        "PYTHONPATH",
+        "FORCE_QWENVL_VIDEO_READER",
+        "STRICT_VIDEO_READER",
+        "TORCHCODEC_NUM_THREADS",
+        "LOG_VIDEO_GRID",
+    )
+
+    package_versions = {
+        package: _package_version(package)
+        for package in (
+            "torch",
+            "torchvision",
+            "torchcodec",
+            "flash-attn",
+            "transformers",
+            "qwen-vl-utils",
+            "accelerate",
+            "wandb",
+            "decord2",
+            "av",
+        )
+    }
+
+    video_reader = None
+    torchvision_has_read_video = None
+    try:
+        import qwen_vl_utils.vision_process as qwen_vision_process
+
+        qwen_vision_process.get_video_reader_backend.cache_clear()
+        video_reader = qwen_vision_process.get_video_reader_backend()
+    except Exception as exc:
+        video_reader = f"unavailable: {exc}"
+    try:
+        import torchvision
+
+        torchvision_has_read_video = hasattr(torchvision.io, "read_video")
+    except Exception:
+        torchvision_has_read_video = None
+
+    ffmpeg_version = None
+    try:
+        ffmpeg_version = subprocess.check_output(["ffmpeg", "-version"], stderr=subprocess.DEVNULL).decode().splitlines()[0]
+    except Exception:
+        pass
+
+    cuda_info = {}
+    try:
+        cuda_info = {
+            "torch_cuda": torch.version.cuda,
+            "cuda_available": torch.cuda.is_available(),
+            "device": torch.cuda.get_device_name(0) if torch.cuda.is_available() else None,
+            "capability": list(torch.cuda.get_device_capability(0)) if torch.cuda.is_available() else None,
+        }
+    except Exception as exc:
+        cuda_info = {"error": str(exc)}
+
+    repos = {"workspace": _repo_state(workspace_root)}
+    if lmms_root != workspace_root:
+        repos["lmms_eval"] = _repo_state(lmms_root)
