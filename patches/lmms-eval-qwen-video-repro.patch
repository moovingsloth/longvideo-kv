+    def _configure_video_reader(self) -> None:
+        forced_reader = os.environ.get("FORCE_QWENVL_VIDEO_READER")
+        strict_reader = os.environ.get("STRICT_VIDEO_READER", "").lower() in {"1", "true", "yes"}
+        if not forced_reader and not strict_reader:
+            return
+
+        try:
+            import qwen_vl_utils.vision_process as qwen_vision_process
+        except Exception as exc:
+            raise RuntimeError("Failed to import qwen_vl_utils.vision_process while configuring video reader") from exc
+
+        if forced_reader:
+            qwen_vision_process.get_video_reader_backend.cache_clear()
+            selected_reader = qwen_vision_process.get_video_reader_backend()
+            if selected_reader != forced_reader:
+                raise RuntimeError(f"Expected qwen-vl-utils video reader {forced_reader!r}, got {selected_reader!r}")
+        else:
+            selected_reader = qwen_vision_process.get_video_reader_backend()
+
+        if strict_reader and selected_reader != "torchvision":
+            def _fail_torchvision_fallback(ele):
+                video = ele.get("video", "<unknown>")
+                raise RuntimeError(
+                    f"Strict video reader is enabled: {selected_reader!r} failed for {video!r}; "
+                    "refusing qwen-vl-utils torchvision fallback."
+                )
+
+            qwen_vision_process.VIDEO_READER_BACKENDS["torchvision"] = _fail_torchvision_fallback
+
+        eval_logger.info("qwen-vl-utils video reader backend={} strict={}", selected_reader, strict_reader)
+
+    def _safe_nframes(self, visual: str) -> int:
+        target_frames = int(self.max_num_frames)
+        try:
+            import qwen_vl_utils.vision_process as qwen_vision_process
+
+            reader = qwen_vision_process.get_video_reader_backend()
+            if reader == "torchcodec":
+                from torchcodec.decoders import VideoDecoder
+
+                total_frames = VideoDecoder(visual, num_ffmpeg_threads=1).metadata.num_frames
+            elif reader == "decord":
+                import decord
+
+                vr = decord.VideoReader(visual)
+                total_frames = len(vr)
+            else:
+                return target_frames
+
+            nframes = min(target_frames, int(total_frames))
+            nframes = (nframes // 2) * 2
+            return max(2, nframes)
+        except Exception as exc:
+            eval_logger.warning("Failed to probe video frame count for {}: {}; using max_num_frames={}", visual, exc, target_frames)
+            return target_frames
+
+    def _video_content(self, visual: str) -> dict:
